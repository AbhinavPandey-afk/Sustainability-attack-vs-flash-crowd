# CASCADE — Phase 1 environment configuration
# Copy to .env and adjust if needed. Phase 1 only uses the cluster-topology
# variables below; later phases will extend this file.

# Name of the local k3d cluster used for this project.
CASCADE_CLUSTER_NAME=cascade

# Number of k3s server (control-plane) nodes.
CASCADE_SERVER_COUNT=1

# Number of k3s agent (worker) nodes. Kept small for a normal laptop/desktop.
CASCADE_AGENT_COUNT=2

# Namespace used exclusively by the Phase 1 smoke-test workload.
CASCADE_TEST_NAMESPACE=cascade-test
